  "conditional_followups": {
    "C01": {
      "outcome": "Автоматическое восстановление review без технического выбора оператора",
      "admission_evidence": "PR-475",
      "traceability": "PR-403–407; IMP-03",
      "scope": "Реальные request/full-SHA/current-invocation +1 linkage, bounded repost/reconcile, external push/restart. После доказательства переводятся все consumers и удаляется обычная migration panel. Новые implementation tasks оценить по результату, не писать вымышленный API."
    },
    "C02": {
      "outcome": "Полная сохранность и автоматическое продолжение при dirty work/неизвестном restart owner",
      "admission_evidence": "PR-477, PR-478",
      "traceability": "PR-416/419/421/422/425–431/442/454; IMP-01/04",
      "scope": "Выбранные capture/index/local-history/restore и retained ownership, общий scoped допуск, миграция status/sync/error/FIX/merge/web/constructor. PR-468 решает известный status-only loss, PR-498 только подтвержденный clean/quiescent release. Не объявлять их полной реализацией C02."
    },
    "C03": {
      "outcome": "Durable final Reject и единый changed-spec admission",
      "admission_evidence": "PR-494",
      "traceability": "PR-432–446/455/456; IMP-05/06",
      "scope": "Exact intent/attempt/failure/spec, close confirmation и late push, retained fence после Redis loss, consistent upload/direct Git admission/reservation, безопасная branch preparation. Новый PR после final Reject, тот же PR при обычном Retry. Использовать минимум existing stores; количество implementation tasks определить после boundary proof."
    },
    "C04": {
      "outcome": "Недостающие persistence/backup/readiness гарантии",
      "admission_evidence": "PR-501, PR-504",
      "traceability": "A16/A38; IMP-10",
      "scope": "Конкретные выявленные потери данных/intent, off-host доступность, startup identity, health/readiness и state-compatible rollback. Не считать bundle или Up достаточной гарантией. Production drill не входит в AUTO PR."
    },
    "C05": {
      "outcome": "Совместимое исправление применимой form-parsing уязвимости",
      "admission_evidence": "PR-502",
      "traceability": "A24; IMP-11",
      "scope": "Доставить проверенный compatible dependency upgrade или bounded body-limit mitigation с regression actual request.form path. До результата не выбирать вслепую независимый Starlette pin."
    },
    "C06": {
      "outcome": "Остальные guardrail и входные границы",
      "admission_evidence": "Проверка конкретного usage/perimeter; при изменении Approve использовать PR-492",
      "traceability": "A20–23/A25/A27; R17–19/R24; IMP-05/11",
      "scope": "Полный набор нарушений и bounded label text, sensitive excerpts, Origin/JS-context/webhook destination, sandbox mode и build-context regression. Dockerignore/CLI pins уже существуют. Не вводить общую IAM/SSRF блокировку всех LAN webhook без учета фактического продукта. Новая task нужна для конкретно подтвержденного остатка, а не blanket security sprint."
    },
    "C07": {
      "outcome": "Расширения account profiles, metered API budget, обучаемый selector, 20 repo",
      "admission_evidence": "Реальная потребность в новом transport/account или росте нагрузки",
      "traceability": "A30/A31/A37; IMP-04/09",
      "scope": "Отложены. До metered API отдельно задать валюту/период/scope/soft-hard budget и reservations/settlement. Существующие quota/caps не снимать. До роста измерить capacity/fairness, не писать новый scheduler заранее."
    },
    "C08": {
      "outcome": "Дополнительная browser/accessibility/auth/settings приемка и отдельные onboarding остатки",
      "admission_evidence": "Конкретное изменение соответствующего UI/контракта",
      "traceability": "PR-464; A17/A19/A33/A34/A40/U01-F01–F12; IMP-07/08/09",
      "scope": "Login тесты только с synthetic responses; собственный regression включать в меняющийся control. Если PR-488 докажет конкретный effective-config/ACK defect, выделить ограниченный runtime delta, а не считать весь Settings сломанным. Доступность и audit metadata не объявлять закрытыми по task metrics fix."
    }
